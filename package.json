{
  "name": "microbin-workers",
  "version": "1.0.0",
  "description": "MicroBin for Cloudflare Workers: a tiny, self-hostable pastebin, file sharing service and URL shortener on Workers + D1 + R2.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "pnpm run build:client && pnpm run types",
    "dev": "wrangler dev",
    "build:client": "node scripts/build-client.mjs",
    "types": "wrangler types",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "client-zip": "^2.5.1",
    "hono": "^4.13.12",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "highlight.js": "^11.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "water.css": "^2.1.1",
    "wrangler": "4.146.0"
  },
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
